
&Опция(Имя = "f file", Описание = "Путь до *.cf")
&ТСтрока
&ПоУмолчанию("./1cv8.cf")
Перем ПутьКФайлу;

&Пластилин
// Индикатор прогресса для длительной операции загрузки.
Перем Крутилка;

&КомандаПриложения(Имя = "import", Описание = "Загрузка конфигурации из файла")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьЗагрузку() Экспорт

	Прокрутить("Подключение к базе", 8);
	Прокрутить("Чтение файла конфигурации", 8);
	Прокрутить("Загрузка объектов", 10);
	Прокрутить("Применение изменений", 8);

	Крутилка.Остановить("Конфигурация загружена: " + ПутьКФайлу);

КонецПроцедуры

Процедура Прокрутить(Знач Сообщение, Знач КоличествоТиков)

	Крутилка.Тик(Сообщение);
	ОставшиесяТики = КоличествоТиков;
	Пока ОставшиесяТики > 0 Цикл
		Крутилка.ТикСПаузой(80);
		ОставшиесяТики = ОставшиесяТики - 1;
	КонецЦикла;

КонецПроцедуры