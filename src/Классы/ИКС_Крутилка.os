
// ANSI ESC-символ.
Перем _ESC;

// ANSI-последовательность сброса оформления.
Перем _Сброс;

// Символ возврата каретки для перерисовки текущей строки.
Перем _ВозвратКаретки;

// Кадры вращающегося индикатора.
Перем _КадрыСпиннера;

// Осенние символы, которые показываются рядом с индикатором.
Перем _КадрыОсени;

// ANSI-цвета осенней палитры.
Перем _Цвета;

// Сообщения по умолчанию для крутилки без явного текста.
Перем _Слова;

// Номер текущего кадра анимации.
Перем _ТекущийКадр;

// Текущее сообщение рядом с крутилкой.
Перем _ТекущееСообщение;

// Признак активной крутилки.
Перем _Активен;

// Признак отключенного вывода.
Перем _ТихийРежим;

// Признак вывода финальной строки успеха.
Перем _ПоказыватьИтог;

&Желудь("Крутилка")
Процедура ПриСозданииОбъекта()

	_ESC = Символ(27);
	_Сброс = _ESC + "[0m";
	_ВозвратКаретки = Символ(13);

	// Брэйловые точки (U+2800) - дают ощущение вращения
	_КадрыСпиннера = Новый Массив();
	_КадрыСпиннера.Добавить(Символ(10251)); // U+280B
	_КадрыСпиннера.Добавить(Символ(10265)); // U+2819
	_КадрыСпиннера.Добавить(Символ(10297)); // U+2839
	_КадрыСпиннера.Добавить(Символ(10296)); // U+2838
	_КадрыСпиннера.Добавить(Символ(10300)); // U+283C
	_КадрыСпиннера.Добавить(Символ(10292)); // U+2834
	_КадрыСпиннера.Добавить(Символ(10278)); // U+2826
	_КадрыСпиннера.Добавить(Символ(10279)); // U+2827
	_КадрыСпиннера.Добавить(Символ(10247)); // U+2807
	_КадрыСпиннера.Добавить(Символ(10255)); // U+280F

	// Осенние BMP-символы - мэтчатся с аннотациями autumn-library
	_КадрыОсени = Новый Массив();
	_КадрыОсени.Добавить(Символ(10087)); // U+2767 - листопад, символ фреймворка
	_КадрыОсени.Добавить(Символ(9830));  // U+2666 - кленовый лист
	_КадрыОсени.Добавить(Символ(10022)); // U+2726 - желудь (&Желудь)
	_КадрыОсени.Добавить(Символ(9827));  // U+2663 - дуб (&Дуб)
	_КадрыОсени.Добавить(Символ(10047)); // U+273F - завязь, росток (&Завязь)
	_КадрыОсени.Добавить(Символ(10086)); // U+2766 - белка собирает желуди (DI)

	// Осенняя цветовая палитра (ANSI 256 цветов)
	_Цвета = Новый Массив();
	_Цвета.Добавить(_ESC + "[38;5;208m"); // Рыжий
	_Цвета.Добавить(_ESC + "[38;5;214m"); // Золотисто-оранжевый
	_Цвета.Добавить(_ESC + "[38;5;220m"); // Желтый
	_Цвета.Добавить(_ESC + "[38;5;130m"); // Коричнево-красный
	_Цвета.Добавить(_ESC + "[38;5;136m"); // Темно-золотой
	_Цвета.Добавить(_ESC + "[38;5;64m");  // Оливковый

	// Осенние слова - крутятся как листья
	_Слова = Новый Массив();
	_Слова.Добавить("Листья кружатся");
	_Слова.Добавить("Желуди считаются");
	_Слова.Добавить("Дуб думает");
	_Слова.Добавить("Туман стелется");
	_Слова.Добавить("Пластилин мнется");
	_Слова.Добавить("Осень наступает");
	_Слова.Добавить("Урожай собирается");
	_Слова.Добавить("Ежик укладывается");
	_Слова.Добавить("Белка запасается");
	_Слова.Добавить("Ветер гуляет");

	_ТекущийКадр = 0;
	_ТекущееСообщение = "";
	_Активен = Ложь;
	_ТихийРежим = ЭтоНеинтерактивноеОкружение();
	_ПоказыватьИтог = Истина;

КонецПроцедуры

// Отключить вывод в консоль - удобно в тестах.
//
// Параметры:
//  Признак - Булево - Истина отключает вывод крутилки.
Процедура УстановитьТихийРежим(Знач Признак) Экспорт
	_ТихийРежим = Признак;
КонецПроцедуры

Функция ТихийРежимЛи() Экспорт
	Возврат _ТихийРежим;
КонецФункции

// Управляет финальной строкой успеха при остановке.
//
// Параметры:
//  Признак - Булево - Истина показывает финальную строку успеха.
Процедура УстановитьПоказыватьИтог(Знач Признак) Экспорт
	_ПоказыватьИтог = Признак;
КонецПроцедуры

Функция ПоказыватьИтогЛи() Экспорт
	Возврат _ПоказыватьИтог;
КонецФункции

// Сбросить состояние анимации, не меняя настройки вывода.
Процедура Сбросить() Экспорт
	_ТекущийКадр = 0;
	_ТекущееСообщение = "";
	_Активен = Ложь;
КонецПроцедуры

// Запустить спиннер с необязательным начальным сообщением.
// Если сообщение не задано - слова крутятся автоматически.
//
// Параметры:
//  Сообщение - Строка - Начальное сообщение крутилки.
Процедура Запустить(Знач Сообщение = "") Экспорт

	Сбросить();
	_Активен = Истина;
	_ТекущееСообщение = Сообщение;
	Тик();

КонецПроцедуры

// Прокрутить на один кадр с паузой МиллисекундМежТиками мс.
// Удобно для демо-циклов, где нет реальной работы между вызовами.
//
// Параметры:
//  МиллисекундМежТиками - Число - Пауза после тика.
//  НовоеСообщение - Строка - Сообщение, которое заменит текущее.
Процедура ТикСПаузой(Знач МиллисекундМежТиками = 120, Знач НовоеСообщение = "") Экспорт
	Тик(НовоеСообщение);
	Приостановить(МиллисекундМежТиками);
КонецПроцедуры

// Прокрутить на один кадр. Тик с сообщением лениво запускает крутилку.
//
// Параметры:
//  НовоеСообщение - Строка - Сообщение, которое заменит текущее.
Процедура Тик(Знач НовоеСообщение = "") Экспорт

	Если НЕ _Активен Тогда
		Если НовоеСообщение <> "" Тогда
			Запустить(НовоеСообщение);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если НовоеСообщение <> "" Тогда
		_ТекущееСообщение = НовоеСообщение;
	КонецЕсли;

	КадрСпин  = _КадрыСпиннера[_ТекущийКадр % _КадрыСпиннера.Количество()];
	КадрОсени = _КадрыОсени[Цел(_ТекущийКадр / 2) % _КадрыОсени.Количество()];
	Цвет      = _Цвета[Цел(_ТекущийКадр / 5) % _Цвета.Количество()];

	ТекстСообщения = _ТекущееСообщение;
	Если ТекстСообщения = "" Тогда
		ТекстСообщения = _Слова[Цел(_ТекущийКадр / 3) % _Слова.Количество()];
	КонецЕсли;

	Строка = Цвет + КадрСпин + " " + КадрОсени + "  " + ТекстСообщения + "..." + _Сброс;

	Если НЕ _ТихийРежим Тогда
		ВывестиКадр(Строка);
	КонецЕсли;

	_ТекущийКадр = _ТекущийКадр + 1;

КонецПроцедуры

// Остановить спиннер и показать финальное сообщение об успехе.
//
// Параметры:
//  СообщениеИтог - Строка - Текст финальной строки успеха.
//  ПоказыватьИтог - Булево, Неопределено - Переопределяет настройку финального вывода.
Процедура Остановить(Знач СообщениеИтог = "", Знач ПоказыватьИтог = Неопределено) Экспорт

	Если НЕ _Активен Тогда
		Возврат;
	КонецЕсли;

	_Активен = Ложь;
	ПоказыватьСообщениеИтог = ?(ПоказыватьИтог = Неопределено, _ПоказыватьИтог, ПоказыватьИтог);

	Если СообщениеИтог = "" Тогда
		СообщениеИтог = "Готово";
	КонецЕсли;

	ЦветУспех = _ESC + "[38;5;64m";
	Маркер = Символ(10087) + " " + Символ(10004); // ❧ ✔
	Строка = ЦветУспех + Маркер + "  " + СообщениеИтог + _Сброс;

	Если НЕ _ТихийРежим Тогда
		Если ПоказыватьСообщениеИтог Тогда
			ВывестиЗавершающуюСтроку(Строка);
		Иначе
			ОчиститьСтроку();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Остановить спиннер и показать сообщение об ошибке.
//
// Параметры:
//  Текст - Строка - Текст сообщения об ошибке.
Процедура ПоказатьОшибку(Знач Текст = "") Экспорт

	Если Текст = "" Тогда
		Текст = "Что-то пошло не так";
	КонецЕсли;

	_Активен = Ложь;

	ЦветОшибки = _ESC + "[38;5;196m";
	Маркер = Символ(9830) + " " + Символ(10008); // ♦ ✘
	Строка = ЦветОшибки + Маркер + "  " + Текст + _Сброс;

	Если НЕ _ТихийРежим Тогда
		ВывестиЗавершающуюСтроку(Строка);
	КонецЕсли;

КонецПроцедуры

// Исполнить действие под крутилкой и гарантированно остановить ее.
// Действие должно иметь экспортный метод Исполнить().
//
// Параметры:
//  Сообщение - Строка - Сообщение на время выполнения действия.
//  Действие - Произвольный - Объект с экспортным методом Исполнить().
//  СообщениеИтог - Строка - Текст финальной строки успеха.
//  СообщениеОшибки - Строка - Текст финальной строки ошибки.
Процедура ВыполнитьДействие(Знач Сообщение, Знач Действие, Знач СообщениеИтог = "", Знач СообщениеОшибки = "") Экспорт

	Запустить(Сообщение);

	Попытка
		Действие.Исполнить();
		Остановить(СообщениеИтог);
	Исключение
		Если СообщениеОшибки = "" Тогда
			СообщениеОшибки = ОписаниеОшибки();
		КонецЕсли;
		ПоказатьОшибку(СообщениеОшибки);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция АктивенЛи() Экспорт
	Возврат _Активен;
КонецФункции

Процедура ВывестиКадр(Знач Строка)
	Консоль.Вывести(_ВозвратКаретки + _ESC + "[2K" + Строка);
КонецПроцедуры

Процедура ВывестиЗавершающуюСтроку(Знач Строка)
	Консоль.Вывести(_ВозвратКаретки + _ESC + "[2K" + Строка + Символы.ПС);
КонецПроцедуры

Процедура ОчиститьСтроку()
	Консоль.Вывести(_ВозвратКаретки + _ESC + "[2K");
КонецПроцедуры

Функция ЭтоНеинтерактивноеОкружение()
	Возврат ПеременнаяСредыЗаполнена("CI")
		ИЛИ ПеременнаяСредыЗаполнена("GITHUB_ACTIONS")
		ИЛИ ПеременнаяСредыЗаполнена("TEAMCITY_VERSION")
		ИЛИ ПеременнаяСредыЗаполнена("TF_BUILD")
		ИЛИ ПеременнаяСредыЗаполнена("BUILD_NUMBER");
КонецФункции

Функция ПеременнаяСредыЗаполнена(Знач Имя)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ЗначениеЗаполнено(Значение) И НРег(Значение) <> "false";
КонецФункции
